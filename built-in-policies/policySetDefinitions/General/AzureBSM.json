{
  "properties": {
    "displayName": "[Preview]: Azure Baseline Security Mode",
    "policyType": "BuiltIn",
    "description": "Azure Baseline Security Mode (https://aka.ms/AzureBSM) helps you secure your Azure environment with a curated set of Microsoft-recommended security controls. It simplifies the adoption of high-impact security protections, helping reduce risk and strengthen your security posture with minimal effort.",
    "metadata": {
      "version": "1.0.0-preview",
      "category": "General",
      "preview": true
    },
    "version": "1.0.0-preview",
    "parameters": {
      "blockStorageAccountPublicAccessEffect": {
        "type": "String",
        "defaultValue": "Deny",
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "metadata": {
          "displayName": "Block public (anonymous) access to storage accounts",
          "description": "Deny blocks storage accounts that allow public (anonymous) blob access, Audit reports them as non-compliant, and Disabled turns off evaluation."
        }
      },
      "blockKeyVaultWithoutPurgeProtectionEffect": {
        "type": "String",
        "defaultValue": "Deny",
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "metadata": {
          "displayName": "Block key vaults without deletion (purge) protection",
          "description": "Deny blocks key vaults that don't have deletion (purge) protection enabled, Audit reports them as non-compliant, and Disabled turns off evaluation."
        }
      },
      "blockStorageAccountSharedKeyAccessEffect": {
        "type": "String",
        "defaultValue": "Deny",
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "metadata": {
          "displayName": "Block shared key access to storage accounts",
          "description": "Deny blocks storage accounts that allow shared key access, Audit reports them as non-compliant, and Disabled turns off evaluation."
        }
      },
      "blockStorageAccountBelowMinimumTlsEffect": {
        "type": "String",
        "defaultValue": "Deny",
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "metadata": {
          "displayName": "Block storage accounts below the minimum TLS version",
          "description": "Deny blocks storage accounts configured below the minimum TLS version, Audit reports them as non-compliant, and Disabled turns off evaluation."
        }
      },
      "blockKeyVaultPublicNetworkAccessEffect": {
        "type": "String",
        "defaultValue": "Deny",
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "metadata": {
          "displayName": "Block public network access to key vaults",
          "description": "Deny blocks key vaults that allow public network access, Audit reports them as non-compliant, and Disabled turns off evaluation."
        }
      },
      "blockStorageAccountInsecureTransferEffect": {
        "type": "String",
        "defaultValue": "Deny",
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "metadata": {
          "displayName": "Block insecure transfer to storage accounts",
          "description": "Deny blocks storage accounts that allow insecure (non-HTTPS) transfer, Audit reports them as non-compliant, and Disabled turns off evaluation."
        }
      },
      "blockKeyVaultWithoutSoftDeleteEffect": {
        "type": "String",
        "defaultValue": "Deny",
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "metadata": {
          "displayName": "Block key vaults without soft delete",
          "description": "Deny blocks key vaults that don't have soft delete enabled, Audit reports them as non-compliant, and Disabled turns off evaluation."
        }
      }
    },
    "policyDefinitions": [
