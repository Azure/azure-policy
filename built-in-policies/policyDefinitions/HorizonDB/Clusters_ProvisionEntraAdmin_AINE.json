{
  "properties": {
    "displayName": "[Preview]: Azure HorizonDB clusters should have a Microsoft Entra administrator provisioned",
    "policyType": "BuiltIn",
    "mode": "Indexed",
    "description": "Using a Microsoft Entra administrator for Azure HorizonDB clusters simplifies permission management and centralizes identity management for database users.",
    "metadata": {
      "version": "1.0.0-preview",
      "category": "HorizonDB",
      "preview": true
    },
    "version": "1.0.0-preview",
    "parameters": {
      "effect": {
        "type": "String",
        "metadata": {
          "displayName": "Effect",
          "description": "Enable or disable the execution of the policy"
        },
        "allowedValues": [
          "AuditIfNotExists",
          "Disabled"
        ],
        "defaultValue": "AuditIfNotExists"
      }
    },
    "policyRule": {
      "if": {
        "field": "type",
        "equals": "Microsoft.HorizonDb/clusters"
      },
      "then": {
        "effect": "[parameters('effect')]",
        "details": {
          "type": "Microsoft.HorizonDb/clusters/microsoftEntraAdministrators"
        }
      }
    },
    "versions": [
      "1.0.0-PREVIEW"
    ]
  },
  "id": "/providers/Microsoft.Authorization/policyDefinitions/b51aacd8-e77a-4ac9-b6a5-26149b091e89",
  "name": "b51aacd8-e77a-4ac9-b6a5-26149b091e89"
}