{
  "properties": {
    "displayName": "[Preview]: API Management services should use private link",
    "policyType": "BuiltIn",
    "mode": "Indexed",
    "description": "API Management services should have at least one approved private endpoint connection. Clients in a virtual network can securely access API Management services that have private endpoint connections through private links.",
    "metadata": {
      "version": "1.0.0-preview",
      "category": "Sovereignty",
      "preview": true
    },
    "version": "1.0.0-preview",
    "parameters": {
      "effect": {
        "type": "String",
        "metadata": {
          "displayName": "Effect",
          "description": "Enable or disable the execution of the policy"
        },
        "allowedValues": [
          "Audit",
          "Disabled"
        ],
        "defaultValue": "Audit"
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.ApiManagement/service"
          },
          {
            "count": {
              "field": "Microsoft.ApiManagement/service/privateEndpointConnections[*]",
              "where": {
                "field": "Microsoft.ApiManagement/service/privateEndpointConnections[*].privateLinkServiceConnectionState.status",
                "equals": "Approved"
              }
            },
            "less": 1
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]"
      }
    },
    "versions": [
      "1.0.0-PREVIEW"
    ]
  },
  "id": "/providers/Microsoft.Authorization/policyDefinitions/37ccbf90-57ed-4a86-b246-cece8ed746fe",
  "name": "37ccbf90-57ed-4a86-b246-cece8ed746fe"
}