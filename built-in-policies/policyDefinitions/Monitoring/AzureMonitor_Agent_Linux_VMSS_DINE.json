                    "equals": "Oracle-Linux"
                  },
                  {
                    "field": "Microsoft.Compute/imageSku",
                    "equals": "ol10-arm64-lvm-gen2"
                  }
                ]
              },
              {
                "allOf": [
                  {
                    "field": "Microsoft.Compute/imagePublisher",
                    "equals": "almalinux"
                  },
                  {
                    "field": "Microsoft.Compute/imageOffer",
                    "like": "almalinux*"
                  },
                  {
                    "anyOf": [
                      {
                        "field": "Microsoft.Compute/imageSku",
                        "like": "8*"
                      },
                      {
                        "allOf": [
                          {
                            "field": "Microsoft.Compute/imageSku",
                            "like": "9*"
                          },
                          {
                            "field": "Microsoft.Compute/imageSku",
                            "notContains": "arm"
                          }
