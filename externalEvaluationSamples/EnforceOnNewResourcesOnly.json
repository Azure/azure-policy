{
    "properties": {
        "displayName": "Deny new storage accounts with public access enabled, but do not enforce on existing storage accounts",
        "policyType": "Custom",
        "mode": "Indexed",
        "policyRule": {
            "if": {
                "allOf": [
                    {
                        "field": "type",
                        "equals": "Microsoft.Storage/storageAccounts"
                    },
                    {
                        "field": "Microsoft.Storage/storageAccounts/publicNetworkAccess",
                        "equals": "Enabled"
                    },
                    {
                        "value": "[claims().exists]",
                        "equals": 0
                    }
                ]
            },
            "then": {
                "effect": "deny"
            }
        },
        "externalEvaluationEnforcementSettings": {
            "roleDefinitionIds": [
                "/providers/Microsoft.Authorization/roleDefinitions/acdd72a7-3385-48ef-bd42-f606fba81ae7"
            ],
            "endpointSettings": {
                "kind": "AzureResourceGraph",
                "details": {
                    "query": "[format( 'resources | where type =~ \"microsoft.storage/storageaccounts\" | where name == \"{0}\" | summarize exists = count() > 0', field('name'))]",
                    "queryProjectedClaims": [
                        "exists"
                    ]
                }
            }
        }
    }
}
